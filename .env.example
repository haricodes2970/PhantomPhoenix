# PHANTOM PHOENIX - Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env with real credentials.

# Database (matches compose.yaml defaults)
POSTGRES_USER=phantom
# Use a unique local password; never commit real credentials.
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=phantom_phoenix
DATABASE_URL=postgresql+asyncpg://phantom:change-me-local-only@localhost:5432/phantom_phoenix

# API
HOST=0.0.0.0
PORT=8000
RELOAD=false
WORKERS=1

# Model
MODEL_ID=buildborderless/CommunityForensics-DeepfakeDet-ViT
DEVICE=auto
MAX_IMAGE_SIZE_MB=15
MAX_DIMENSION_PX=8192

# Verdict thresholds (provisional screening, not calibrated)
LIKELY_AI_THRESHOLD=0.80
LIKELY_REAL_THRESHOLD=0.20

# Authentication (Milestone 12)
# REQUIRED. Signing secret for session tokens. Minimum 32 characters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# NEVER commit a real value. Rotate by replacing the value (invalidates all
# sessions immediately - tokens signed with the old secret fail validation).
AUTH_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cookie flags. COOKIE_SECURE must be true whenever the API is served over
# HTTPS (production). Leave false for local HTTP development only.
COOKIE_SECURE=false

# Rate limits (events per 60s sliding window, enforced per API process)
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_SCAN_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=120